# tentacles.service — GitHub Actions host runner supervisor (daemon unit).
#
# The daemon must be able to start/stop transient slot units
# (tentacle-<id>.service) as an unprivileged user. That requires a narrow
# polkit rule allowing `tentacles` to manage only `tentacle-*.service`
# (or a systemd user transient scope). See the "systemd integration"
# section of the README.
#
# If polkit/dbus is too heavy for v1, the daemon may run as root with the
# hardening below (NoNewPrivileges=yes, ProtectSystem=strict) — documented
# technical debt; confine it further when you can.

[Unit]
Description=GitHub Actions host runner supervisor
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=tentacles
ExecStart=/usr/local/sbin/tentacles --config /etc/tentacles/config.yaml
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/tentacles /var/log/tentacles /run/tentacles

[Install]
WantedBy=multi-user.target
