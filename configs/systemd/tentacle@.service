# DEPRECATED: manual template instances are not tracked by the supervisor's
# tentacle-<numeric-id>.service discovery and must not be enabled alongside it.
# Use the transient units created by tentacles. This disabled reference only
# documents the equivalent credential and privilege settings; it does not
# materialize/chown slots or mint JIT configurations.
[Unit]
Description=Unsupported manual GitHub Actions runner slot %i
ConditionPathExists=/etc/tentacles/enable-unsupported-manual-template

[Service]
Type=exec
User=gha-runner
Group=gha-runner
WorkingDirectory=/var/lib/tentacles/slots/%i
EnvironmentFile=/etc/tentacles/runner.env
LoadCredential=jit:/run/tentacles/%i.jit
# ':' disables systemd environment expansion; the shell expands the variables.
# The official runner still receives the secret in argv for its lifetime.
ExecStart=:/bin/sh -c 'jit=$(cat "$CREDENTIALS_DIRECTORY/jit") || exit; exec ./run.sh --jitconfig "$jit"'
KillMode=mixed
TimeoutStopSec=30
Nice=5
CPUQuota=400%
MemoryMax=8G
TasksMax=4096
PrivateTmp=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
CPUAccounting=yes
MemoryAccounting=yes
# Use explicit runner HOME paths: %h in a system manager refers to root's home.
ReadWritePaths=/var/lib/tentacles/slots/%i /tmp /home/gha-runner/.cache /home/gha-runner/.local/share/mise /home/gha-runner/go/pkg/mod
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
